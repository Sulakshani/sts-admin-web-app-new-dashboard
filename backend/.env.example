# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database
DATABASE_MAX_CONNECTIONS=10
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONN_MAX_LIFETIME=300

# Server Configuration
PORT=8083

# Email Configuration (Gmail SMTP - Free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=STS Admin System

# Frontend URL
FRONTEND_URL=http://localhost:4200

# SMS Configuration (eSMS API)
SMS_MODE=production
APPROVAL_NOTIFICATION_PHONE=94715342627,94772945875
DIALOG_SMS_METHOD=api_v2
DIALOG_SMS_API_URL=https://e-sms.dialog.lk/api/v2
DIALOG_SMS_ACCESS_TOKEN=your_dialog_api_v2_access_token_here
DIALOG_SMS_MASK=YourMask
ESMS_API_URL=https://api.esms.lk/v1/sms/send
ESMS_API_KEY=your_esms_api_key_here
ESMS_SENDER_ID=BusLounge

# JWT Configuration (add this for production)
# JWT_SECRET=your-strong-random-secret-key-here
